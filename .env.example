# ============================================================================
# Nexo — variables de entorno
# ----------------------------------------------------------------------------
# Copiar a `.env` y ajustar. `.env` está en .gitignore: NO se sube al repo.
#
#   cp .env.example .env
#
# Todos los servicios de docker-compose leen de este archivo.
# ============================================================================

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=nexo
POSTGRES_PASSWORD=cambiar_en_produccion
POSTGRES_DB=nexo

# Puerto del host para conectarse a la BD desde afuera (psql, DBeaver, …).
# Solo se publica en desarrollo (docker-compose.override.yml).
# Si ya tenés un PostgreSQL corriendo en la máquina, cambialo (ej. 5433) —
# esto NO afecta la conexión entre contenedores, que siempre usa db:5432.
POSTGRES_HOST_PORT=5433

# ── Backend (NestJS) ────────────────────────────────────────────────────────
BACKEND_PORT=3001

# El host es `db`: el nombre del servicio en la red de compose, no localhost.
DATABASE_URL=postgresql://nexo:cambiar_en_produccion@db:5432/nexo?schema=public

# Generar uno propio:  openssl rand -base64 48
JWT_SECRET=cambiar_esto_por_un_secreto_largo_y_aleatorio
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Usuario administrador del seed ──────────────────────────────────────────
# Las lee `prisma/seed.ts` (`npm run prisma:seed`), no la app. Igual se pasan
# al contenedor del backend, que es desde donde se siembra:
#   docker compose exec backend npm run prisma:seed
# El seed es idempotente — si el usuario ya existe, NO le cambia la contraseña.
# Con NODE_ENV=production, ADMIN_PASSWORD deja de tener default y es obligatoria.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=

# ── Frontend (Reflex) ───────────────────────────────────────────────────────
FRONTEND_PORT=3000

# Puerto del backend propio de Reflex (websocket de estado). Distinto del
# backend NestJS. El navegador se conecta acá, así que se publica siempre.
REFLEX_BACKEND_PORT=8000

# URL del backend NestJS vista DESDE EL CONTENEDOR del frontend.
# El state de Reflex corre server-side, así que las llamadas HTTP salen del
# contenedor y resuelven `backend` por DNS de la red de compose.
# Fuera de Docker, usar http://localhost:3001/api
API_BASE_URL=http://backend:3001/api
